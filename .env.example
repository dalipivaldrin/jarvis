# Kopiere diese Datei zu ".env" und trage deine Werte ein.

JARVIS_USER_NAME=Drini
JARVIS_CITY=Zürich

# KI-Gehirn: ollama (gratis, läuft lokal) oder claude (API-Key mit Guthaben)
JARVIS_PROVIDER=ollama
JARVIS_OLLAMA_MODEL=qwen3:8b
# Schneller, aber etwas weniger schlau: qwen3:4b (vorher: ollama pull qwen3:4b)
JARVIS_OLLAMA_KEEP_ALIVE=60m

# Nur für JARVIS_PROVIDER=claude – Key holen: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
JARVIS_MODEL=claude-sonnet-5-5
JARVIS_WEB_SEARCH=true

# Sprache
JARVIS_LANGUAGE=de-CH

# Stimme: edge (menschlich, Internet nötig) oder mac (offline)
JARVIS_TTS=edge
# Männlich: de-CH-JanNeural, de-DE-ConradNeural, de-DE-KillianNeural
# Weiblich: de-CH-LeniNeural, de-DE-KatjaNeural, de-DE-AmalaNeural
JARVIS_EDGE_VOICE=de-CH-JanNeural
JARVIS_EDGE_RATE=+0%
# Mac-Stimme (Ersatz ohne Internet)
JARVIS_VOICE=Anna
JARVIS_WAKE_WORD=jarvis
